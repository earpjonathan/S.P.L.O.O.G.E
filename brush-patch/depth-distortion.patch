diff --git a/crates/brush-bench-test/tests/distortion_forward.rs b/crates/brush-bench-test/tests/distortion_forward.rs
new file mode 100644
index 0000000..171a0a2
--- /dev/null
+++ b/crates/brush-bench-test/tests/distortion_forward.rs
@@ -0,0 +1,127 @@
+//! Forward-pass checks for the depth-distortion channel.
+//!
+//! These need no gradients, and they catch the accumulation bugs that would
+//! otherwise only show up as "training converges slightly worse".
+//!
+//! The load-bearing one is `a_total_equals_alpha`. Channel 5 accumulates
+//! `sum_i w_i` with `w_i = alpha_i * T_i`, and each step subtracts exactly
+//! that from the running transmittance (`T_next = T * (1 - alpha)`), so the
+//! sum telescopes to `1 - T_final` -- which is what channel 3 already holds.
+//! The two must therefore agree to floating point. If the weights are
+//! accumulated in the wrong place (outside the contribute branch, or after
+//! the transmittance update) this test fails immediately and unambiguously.
+
+use brush_render::bwd::render_splats_with_pass;
+use brush_render::gaussian_splats::RasterPass;
+use brush_render::{
+    camera::Camera,
+    gaussian_splats::{SplatRenderMode, Splats},
+    kernels::camera_model::CameraModel,
+};
+use burn::tensor::{Tensor, s};
+use glam::Vec3;
+
+const PASS: RasterPass = RasterPass::BackwardDistortion;
+
+fn std_cam() -> Camera {
+    Camera::new(
+        glam::vec3(0.0, 0.0, -3.0),
+        glam::Quat::IDENTITY,
+        0.6,
+        0.6,
+        glam::vec2(0.5, 0.5),
+        CameraModel::Pinhole,
+    )
+}
+
+fn scene_splats(device: &burn::tensor::Device, n: usize) -> Splats {
+    // Splats stacked along the view axis so a ray crosses several of them at
+    // different depths -- the case the distortion term exists to penalise.
+    let mut means = vec![];
+    let mut rots = vec![];
+    let mut log_scales = vec![];
+    let mut sh_dc = vec![];
+    let mut raw_opac = vec![];
+    for i in 0..n {
+        let z = -0.4 + 0.8 * (i as f32) / (n.max(2) - 1) as f32;
+        means.extend_from_slice(&[0.0, 0.0, z]);
+        rots.extend_from_slice(&[0.9, 0.1, 0.05, 0.03]);
+        log_scales.extend_from_slice(&[-1.4, -1.5, -1.6]);
+        sh_dc.extend_from_slice(&[0.5, 0.5, 0.5]);
+        raw_opac.push(1.2);
+    }
+    Splats::from_raw(
+        means, rots, log_scales, sh_dc, raw_opac,
+        SplatRenderMode::Default, device,
+    )
+}
+
+async fn render(n: usize) -> (Tensor<3>, glam::UVec2) {
+    // render_splats_with_pass goes through the autodiff node even when we only
+    // want the forward, so the device must be lifted or it panics at
+    // burn_glue.rs:253.
+    let device =
+        burn::tensor::Device::from(brush_cube::test_helpers::test_device().await).autodiff();
+    let cam = std_cam();
+    let img_size = glam::uvec2(32, 32);
+    let splats = scene_splats(&device, n);
+    let diff = render_splats_with_pass(splats, &cam, img_size, Vec3::ZERO, PASS).await;
+    (diff.img, img_size)
+}
+
+#[tokio::test]
+async fn out_img_has_seven_channels() {
+    let (img, sz) = render(4).await;
+    assert_eq!(
+        img.dims(),
+        [sz.y as usize, sz.x as usize, 7],
+        "BackwardDistortion must widen out_img to rgba + distortion + A_total + B_total"
+    );
+}
+
+#[tokio::test]
+async fn a_total_equals_alpha() {
+    let (img, _) = render(4).await;
+    let alpha = img.clone().slice(s![.., .., 3..4]);
+    let a_total = img.clone().slice(s![.., .., 5..6]);
+    let err = (alpha - a_total)
+        .abs()
+        .max()
+        .into_scalar_async::<f32>()
+        .await
+        .expect("readback");
+    assert!(
+        err < 1e-5,
+        "sum_i w_i must telescope to 1 - T_final (the alpha channel); max err {err}"
+    );
+}
+
+#[tokio::test]
+async fn distortion_is_non_negative() {
+    // Splats are traversed front-to-back, so every pair term is
+    // w_i * (t_i - t_j) with t_i >= t_j. The sum cannot be negative; a
+    // negative value means the prefix sums were updated before the pair term
+    // was formed.
+    let (img, _) = render(4).await;
+    let d = img.slice(s![.., .., 4..5]);
+    let lo = d.min().into_scalar_async::<f32>().await.expect("readback");
+    assert!(lo >= -1e-6, "distortion must be >= 0, saw {lo}");
+}
+
+#[tokio::test]
+async fn single_splat_has_zero_distortion() {
+    // One splat means no pairs, so the double sum is empty.
+    let (img, _) = render(1).await;
+    let d = img.slice(s![.., .., 4..5]);
+    let hi = d.max().into_scalar_async::<f32>().await.expect("readback");
+    assert!(hi < 1e-6, "a single splat cannot self-pair, saw {hi}");
+}
+
+#[tokio::test]
+async fn stacked_splats_have_positive_distortion() {
+    // Four splats spread along the ray is exactly the slab this loss targets.
+    let (img, _) = render(4).await;
+    let d = img.slice(s![.., .., 4..5]);
+    let hi = d.max().into_scalar_async::<f32>().await.expect("readback");
+    assert!(hi > 1e-5, "depth-spread splats must register distortion, saw {hi}");
+}
