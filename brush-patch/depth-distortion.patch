+/// `burn-dispatch/src/tensor.rs:98`. That is why `--lpips-loss-weight` panics
+/// four seconds into training: the path is simply never exercised, since the
+/// weight defaults to 0.0.
+///
+/// Lifting once at load keeps the weights frozen -- no optimiser is ever given
+/// them -- while letting gradients flow through to the prediction, which is the
+/// only reason to have LPIPS in the loss at all.
+struct LiftToAutodiff;
+
+impl ModuleMapper for LiftToAutodiff {
+    fn map_float<const D: usize>(&mut self, param: Param<Tensor<D>>) -> Param<Tensor<D>> {
+        // require_grad(false): the backbone is frozen, so there is no reason to
+        // compute or store a gradient for ~14M VGG parameters every step.
+        // Gradients still flow THROUGH the convolutions to the prediction,
+        // which is the only thing this loss is for.
+        param.map(|t| Tensor::from_inner(t).set_require_grad(false))
+    }
+}
