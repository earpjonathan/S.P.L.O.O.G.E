@@ -0,0 +1,306 @@
+//! Finite-difference check for the depth-distortion BACKWARD pass.
+//!
+//! The forward is already proven by `distortion_forward.rs`, so any failure
+//! here is unambiguously a backward bug — which is the whole reason that
+//! test was written without gradients.
+//!
+//! Two things make this test valid and are easy to get wrong:
+//!
+//! * The loss slices channel 4 ONLY. Channels 5/6 (`A_total`, `B_total`) are
+//!   saved forward state with no gradient path, so a plain `img.mean()` would
+//!   hand them upstream gradient that the backward deliberately ignores, and
+//!   finite-diff would disagree for a reason that is not a bug.
+//! * The pass is `BackwardDistortionSmoothCutoff`. The hard 1/255 cutoff is a
+//!   step discontinuity; central differences straddle it and produce garbage.
+
+use brush_render::bwd::render_splats_with_pass;
+use brush_render::gaussian_splats::RasterPass;
+use brush_render::{
+    camera::Camera,
+    gaussian_splats::{SplatRenderMode, Splats},
+    kernels::camera_model::CameraModel,
+};
+use burn::tensor::{Gradients, Tensor, s};
+use glam::Vec3;
+
+const PASS: RasterPass = RasterPass::BackwardDistortionSmoothCutoff;
+
+#[derive(Clone)]
+struct Scene {
+    means: Vec<f32>,
+    rots: Vec<f32>,
+    log_scales: Vec<f32>,
+    sh_dc: Vec<f32>,
+    raw_opac: Vec<f32>,
+}
+
+/// Four splats stacked along the view ray — the slab this loss targets.
+/// Small lateral offsets and per-splat opacity break the symmetry, so a
+/// sign error cannot cancel itself across a symmetric arrangement.
+fn base_scene() -> Scene {
+    let n = 4usize;
+    let mut s = Scene {
+        means: vec![],
+        rots: vec![],
+        log_scales: vec![],
+        sh_dc: vec![],
+        raw_opac: vec![],
+    };
+    let offs = [(0.00f32, 0.00f32), (0.05, -0.03), (-0.04, 0.06), (0.02, 0.04)];
+    let opac = [1.30f32, 1.05, 1.45, 1.15];
+    for i in 0..n {
+        let z = -0.4 + 0.8 * (i as f32) / (n - 1) as f32;
+        s.means.extend_from_slice(&[offs[i].0, offs[i].1, z]);
+        s.rots.extend_from_slice(&[0.90, 0.10, 0.05, 0.03]);
+        s.log_scales.extend_from_slice(&[-1.4, -1.5, -1.6]);
+        s.sh_dc.extend_from_slice(&[0.5, 0.5, 0.5]);
+        s.raw_opac.push(opac[i]);
+    }
+    s
+}
+
+fn std_cam() -> Camera {
+    Camera::new(
+        glam::vec3(0.0, 0.0, -3.0),
+        glam::Quat::IDENTITY,
+        0.6,
+        0.6,
+        glam::vec2(0.5, 0.5),
+        CameraModel::Pinhole,
+    )
+}
+
+fn build_splats(scene: &Scene, device: &burn::tensor::Device) -> Splats {
+    Splats::from_raw(
+        scene.means.clone(),
+        scene.rots.clone(),
+        scene.log_scales.clone(),
+        scene.sh_dc.clone(),
+        scene.raw_opac.clone(),
+        SplatRenderMode::Default,
+        device,
+    )
+}
+
+/// Scalar loss = mean of the distortion channel alone.
+fn distortion_loss(img: Tensor<3>) -> Tensor<1> {
+    img.slice(s![.., .., 4..5]).mean()
+}
+
+async fn render_value(
+    scene: &Scene,
+    cam: &Camera,
+    img_size: glam::UVec2,
+    device: &burn::tensor::Device,
+) -> f32 {
+    let splats = build_splats(scene, device);
+    let diff = render_splats_with_pass(splats, cam, img_size, Vec3::ZERO, PASS).await;
+    distortion_loss(diff.img)
+        .into_scalar_async::<f32>()
+        .await
+        .expect("loss readback")
+}
+
+async fn analytical_grads(
+    scene: &Scene,
+    cam: &Camera,
+    img_size: glam::UVec2,
+    device: &burn::tensor::Device,
+) -> (Splats, Gradients) {
+    let splats = build_splats(scene, device);
+    let diff = {
+        let splats = splats.clone();
+        render_splats_with_pass(splats, cam, img_size, Vec3::ZERO, PASS).await
+    };
+    let grads = distortion_loss(diff.img).backward();
+    (splats, grads)
+}
+
+#[derive(Clone, Copy)]
+enum Lane {
+    Mean,
+    Rot,
+    LogScale,
+    ShDc,
+    RawOpac,
+}
+
+fn lane_name(lane: Lane) -> &'static str {
+    match lane {
+        Lane::Mean => "means",
+        Lane::Rot => "rots",
+        Lane::LogScale => "log_scales",
+        Lane::ShDc => "sh_dc",
+        Lane::RawOpac => "raw_opac",
+    }
+}
+
+fn perturb(scene: &mut Scene, lane: Lane, splat: usize, comp: usize, delta: f32) {
+    match lane {
+        Lane::Mean => scene.means[splat * 3 + comp] += delta,
+        Lane::Rot => scene.rots[splat * 4 + comp] += delta,
+        Lane::LogScale => scene.log_scales[splat * 3 + comp] += delta,
+        Lane::ShDc => scene.sh_dc[splat * 3 + comp] += delta,
+        Lane::RawOpac => scene.raw_opac[splat] += delta,
+    }
+}
+
+async fn read_first<const D: usize>(t: Tensor<D>) -> f32 {
+    t.into_data_async()
+        .await
+        .expect("readback")
+        .into_vec::<f32>()
+        .expect("vec")[0]
+}
+
+async fn analytical_at(
+    splats: &Splats,
+    grads: &Gradients,
+    lane: Lane,
+    splat: usize,
+    comp: usize,
+) -> f32 {
+    match lane {
+        Lane::Mean => {
+            let g = splats.transforms.grad(grads).expect("transforms grad");
+            read_first(g.slice(s![splat..splat + 1, comp..comp + 1])).await
+        }
+        Lane::Rot => {
+            let g = splats.transforms.grad(grads).expect("transforms grad");
+            let c = 3 + comp;
+            read_first(g.slice(s![splat..splat + 1, c..c + 1])).await
+        }
+        Lane::LogScale => {
+            let g = splats.transforms.grad(grads).expect("transforms grad");
+            let c = 7 + comp;
+            read_first(g.slice(s![splat..splat + 1, c..c + 1])).await
+        }
+        Lane::ShDc => {
+            let g = splats.sh_coeffs.grad(grads).expect("sh grad");
+            read_first(g.slice(s![splat..splat + 1, 0..1, comp..comp + 1])).await
+        }
+        Lane::RawOpac => {
+            let g = splats.raw_opacities.grad(grads).expect("opac grad");
+            read_first(g.slice(s![splat..splat + 1])).await
+        }
+    }
+}
+
+#[tokio::test]
+async fn distortion_finite_difference() {
+    let device =
+        burn::tensor::Device::from(brush_cube::test_helpers::test_device().await).autodiff();
+    let cam = std_cam();
+    let img_size = glam::uvec2(32, 32);
+    let scene = base_scene();
+
+    let eps = 1e-3_f32;
+    let rel_tol = 0.02_f32;
+    let abs_tol = 2e-6_f32;
+
+    let (splats, grads) = analytical_grads(&scene, &cam, img_size, &device).await;
+
+    // Mean z is the load-bearing case: it is the ONLY route by which the
+    // depth gradient dL/dt reaches a parameter, so if the new
+    // depth -> mean_c.z -> mean path is wrong, these are the entries that
+    // catch it. The x/y entries exercise the alpha route via the 2D
+    // projection, which is the other half of the chain.
+    let cases: &[(Lane, usize, usize)] = &[
+        (Lane::Mean, 0, 2),
+        (Lane::Mean, 1, 2),
+        (Lane::Mean, 2, 2),
+        (Lane::Mean, 3, 2),
+        (Lane::Mean, 0, 0),
+        (Lane::Mean, 1, 1),
+        (Lane::RawOpac, 0, 0),
+        (Lane::RawOpac, 1, 0),
+        (Lane::RawOpac, 2, 0),
+        (Lane::RawOpac, 3, 0),
+        (Lane::LogScale, 0, 0),
+        (Lane::LogScale, 2, 1),
+        (Lane::Rot, 1, 2),
+    ];
+
+    let mut failures = vec![];
+    for &(lane, splat, comp) in cases {
+        let mut plus = scene.clone();
+        perturb(&mut plus, lane, splat, comp, eps);
+        let mut minus = scene.clone();
+        perturb(&mut minus, lane, splat, comp, -eps);
+
+        let f_plus = render_value(&plus, &cam, img_size, &device).await;
+        let f_minus = render_value(&minus, &cam, img_size, &device).await;
+        let numeric = (f_plus - f_minus) / (2.0 * eps);
+        let analytic = analytical_at(&splats, &grads, lane, splat, comp).await;
+
+        let diff = (numeric - analytic).abs();
+        let scale = numeric.abs().max(analytic.abs());
+        let ok = diff <= abs_tol || diff <= rel_tol * scale;
+        println!(
+            "{:>10}[{}][{}]  numeric {:>12.6e}  analytic {:>12.6e}  {}",
+            lane_name(lane),
+            splat,
+            comp,
+            numeric,
+            analytic,
+            if ok { "ok" } else { "MISMATCH" }
+        );
+        if !ok {
+            failures.push(format!(
+                "{}[{}][{}]: numeric {:e} vs analytic {:e}",
+                lane_name(lane),
+                splat,
+                comp,
+                numeric,
+                analytic
+            ));
+        }
+    }
+    assert!(failures.is_empty(), "gradient mismatches:\n{}", failures.join("\n"));
+}
+
+#[tokio::test]
+async fn distortion_gradient_is_nonzero() {
+    // Guards against a vacuous pass: if the scene produced no distortion at
+    // all, every gradient would be 0 and the finite-diff test would agree
+    // trivially. At least one depth gradient must have real magnitude.
+    let device =
+        burn::tensor::Device::from(brush_cube::test_helpers::test_device().await).autodiff();
+    let cam = std_cam();
+    let img_size = glam::uvec2(32, 32);
+    let scene = base_scene();
+    let (splats, grads) = analytical_grads(&scene, &cam, img_size, &device).await;
+
+    let mut max_abs = 0.0f32;
+    for splat in 0..4 {
+        let g = analytical_at(&splats, &grads, Lane::Mean, splat, 2).await;
+        max_abs = max_abs.max(g.abs());
+    }
+    assert!(
+        max_abs > 1e-5,
+        "all depth gradients ~0 ({max_abs:e}) — scene is degenerate, test would be vacuous"
+    );
+}
+
+#[tokio::test]
+async fn distortion_does_not_touch_color() {
+    // L_d depends only on weights and depths, never on colour, so the SH
+    // gradient from the distortion channel must be exactly zero. A nonzero
+    // value means gradient is leaking between channels.
+    let device =
+        burn::tensor::Device::from(brush_cube::test_helpers::test_device().await).autodiff();
+    let cam = std_cam();
+    let img_size = glam::uvec2(32, 32);
+    let scene = base_scene();
+    let (splats, grads) = analytical_grads(&scene, &cam, img_size, &device).await;
+
+    for splat in 0..4 {
+        for comp in 0..3 {
+            let g = analytical_at(&splats, &grads, Lane::ShDc, splat, comp).await;
+            assert!(
+                g.abs() < 1e-9,
+                "sh_dc[{splat}][{comp}] gradient {g:e} should be exactly 0"
+            );
+        }
+    }
+}
